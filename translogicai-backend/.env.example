# TransLogic AI Backend — Environment Variables
# Copy this to .env and fill in your values

# Google Gemini API Key (for AI chat)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouteService Directions API Key (for routing)
Directions_API_KEY=your_ors_api_key_here

# OpenWeatherMap API Key (for weather data)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Azure Computer Vision (for object detection)
AZURE_CV_KEY=your_azure_cv_key_here
AZURE_CV_ENDPOINT=https://your-endpoint.cognitiveservices.azure.com/

# MongoDB Connection String
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/translogicDB?retryWrites=true&w=majority

# Server Port (default: 5000)
PORT=5000

# Frontend URL for CORS (comma-separated for multiple origins)
# Leave empty for development (allows all origins)
# FRONTEND_URL=https://your-frontend.vercel.app
